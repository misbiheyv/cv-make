NODE_ENV=development

# browser pool
BROWSER_POOL_MIN=1
BROWSER_POOL_MAX=10
BROWSER_POOL_IDLE_TIMEOUT_MS=30000
BROWSER_POOL_MAX_QUEUE=100

# nginx
NGINX_CONFIG_PATH=./nginx/nginx.test.conf
RATE_LIMIT=1r/s
RATE_BURST=100
GLOBAL_RATE_LIMIT=10r/s
GLOBAL_RATE_BURST=20

# deployment
# For production, set IMAGE_NAME to your GHCR path: ghcr.io/<user>/resume
IMAGE_NAME=resume-app
IMAGE_TAG=latest
DOMAIN=localhost
SSL_CERT_PATH=/etc/letsencrypt

# nginx ports
NGINX_PORT=3000
NGINX_SSL_PORT=443

# grafana
GRAFANA_ADMIN_PASSWORD=admin
