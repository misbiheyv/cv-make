# Redis Configuration
# For local development with Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_password_here  # Optional, uncomment if needed

# Or use connection URL (takes precedence if set)
# REDIS_URL=redis://localhost:6379

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Puppeteer Configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium  # For Docker/Linux
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome  # For macOS

# Browser Pool Configuration
BROWSER_POOL_MIN=1           # Minimum browsers to keep alive
BROWSER_POOL_MAX=5           # Maximum browsers allowed
BROWSER_POOL_IDLE_TIMEOUT_MS=60000  # 60 seconds

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info  # debug, info, warn, error
